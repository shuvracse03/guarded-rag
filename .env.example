# Copy to .env to override defaults. All values below are the defaults.
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text
# "ollama" (real embeddings) or "hash" (deterministic, offline; used by tests)
EMBEDDING_BACKEND=ollama
CHROMA_DIR=./chroma_db
MIN_RELEVANCE=0.30
DEFAULT_TOP_K=6
MAX_UPLOAD_BYTES=5242880
LLM_TIMEOUT_S=180
# Demo API keys (synthetic placeholders, NOT secrets). Format: JSON {key: {tenant, role}}
# API_KEYS={"key-acme-analyst":{"tenant":"acme-freight","role":"analyst"}}
